---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface PageLayoutProps extends SeoProps {
  activePath: string;
  showFooterSocial?: boolean;
}

const { title, description, path, ogImage, activePath, showFooterSocial = false } = Astro.props as PageLayoutProps;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={ogImage}
  activePath={activePath}
>
  <Header activePath={activePath} />
  <main id="main">
    <slot />
  </main>
  <Footer showSocial={showFooterSocial} />
</BaseLayout>
