---
import Seo, { type SeoProps } from '../components/Seo.astro';
import { withBase } from '../lib/url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';

export interface BaseLayoutProps extends SeoProps {
  activePath: string;
}

const { title, description, path, ogImage, activePath } = Astro.props as BaseLayoutProps;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--link rel="icon" type="image/x-icon" href={withBase('/icons/sandra-cabedo-favicon.ico')} /> -->
    <!-- <link rel="icon" type="image/x-icon" href={withBase('/icons/sc-favicon-circle.ico')} /> -->
    <link rel="icon" type="image/x-icon" href={withBase('/icons/sc-favicon-no-circle.ico')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@300;400;500;600&display=swap"
    />

    <Seo title={title} description={description} path={path} ogImage={ogImage} />
  </head>
  <body data-active-path={activePath}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
  </body>
</html>
