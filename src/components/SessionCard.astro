---
import type { ImageMetadata } from 'astro';
import ImageFrame from './ImageFrame.astro';
import { withBase } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  coverImage: ImageMetadata;
  coverAlt: string;
}

const { slug, title, description, coverImage, coverAlt } = Astro.props;

const href = withBase(`/${slug}/`);
---

<article class="session-card">
  <a class="session-card__link" href={href}>
    <div class="session-card__media">
      <ImageFrame
        src={coverImage}
        alt={coverAlt}
        loading="lazy"
        sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 90vw"
        class="session-card__image"
      />
    </div>
    <div class="session-card__body">
      <h3 class="session-card__title">{title}</h3>
      <p class="session-card__description">{description}</p>
      <span class="session-card__cue" aria-hidden="true">Ver sesión</span>
    </div>
  </a>
</article>

<style>
  .session-card {
    height: 100%;
  }

  .session-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-bg);
    border: 1px solid var(--color-surface);
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .session-card__link:hover,
  .session-card__link:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-surface-2);
    box-shadow: 0 12px 28px rgba(43, 38, 34, 0.12);
  }

  .session-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .session-card__image {
    height: 100%;
  }

  .session-card__image :global(.image-frame__img) {
    transition: transform 0.4s ease;
  }

  .session-card__link:hover .session-card__image :global(.image-frame__img),
  .session-card__link:focus-visible .session-card__image :global(.image-frame__img) {
    transform: scale(1.04);
  }

  .session-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
  }

  .session-card__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .session-card__description {
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .session-card__cue {
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .session-card__link,
    .session-card__image :global(.image-frame__img) {
      transition: none;
    }

    .session-card__link:hover,
    .session-card__link:focus-visible {
      transform: none;
    }

    .session-card__link:hover .session-card__image :global(.image-frame__img),
    .session-card__link:focus-visible .session-card__image :global(.image-frame__img) {
      transform: none;
    }
  }
</style>
