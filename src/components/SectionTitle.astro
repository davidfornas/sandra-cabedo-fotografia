---
interface Props {
  as?: 'h1' | 'h2' | 'h3';
  eyebrow?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { as: Tag = 'h2', eyebrow, align = 'start', class: className } = Astro.props;
---

<div class:list={['section-title', `section-title--${align}`, className]}>
  {eyebrow && <p class="section-title__eyebrow">{eyebrow}</p>}
  <Tag class="section-title__heading">
    <slot />
  </Tag>
</div>

<style>
  .section-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .section-title--start {
    text-align: start;
    align-items: flex-start;
  }

  .section-title--center {
    text-align: center;
    align-items: center;
  }

  .section-title__eyebrow {
    margin: 0;
    max-width: none;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .section-title__heading {
    font-family: var(--font-title);
    margin: 0;
  }
</style>
