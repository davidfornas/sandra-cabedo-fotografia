---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  subtitle?: string;
}

const { items, subtitle = 'Algunas dudas que suelen surgir antes de reservar vuestra sesión.' } = Astro.props;
---

<section class="faq">
  <div class="container faq__inner">

    <div class="faq__header">
      <h2 class="faq__title">Preguntas frecuentes</h2>
      {subtitle && <p class="faq__subtitle">{subtitle}</p>}
    </div>

    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span class="faq__q-text">{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer-wrap">
            <div class="faq__answer-inner">
              <p class="faq__answer">{item.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-xl);
    border-block-start: 1px solid var(--color-surface-2);
  }

  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── Header ── */

  .faq__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .faq__title {
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .faq__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 55ch;
  }

  /* ── List ── */

  .faq__list {
    display: flex;
    flex-direction: column;
  }

  /* ── Item ── */

  .faq__item {
    border-block-start: 1px solid var(--color-surface-2);
  }

  .faq__item:last-child {
    border-block-end: 1px solid var(--color-surface-2);
  }

  /* ── Summary / Question ── */

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    cursor: pointer;
    user-select: none;
    list-style: none; /* Chrome */
  }

  /* Remove native disclosure triangles */
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::marker { display: none; content: ''; }

  .faq__q-text {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.45;
    flex: 1;
  }

  @media (min-width: 769px) {
    .faq__q-text {
      font-size: 1.0625rem;
    }
  }

  .faq__question:hover .faq__q-text,
  .faq__question:focus-visible .faq__q-text {
    color: var(--color-accent);
  }

  /* Focus ring for keyboard navigation */
  .faq__question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .faq__question:focus:not(:focus-visible) {
    outline: none;
  }

  /* ── Icon (+ that rotates to ×) ── */

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.25s ease;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: var(--color-accent);
    border-radius: 1px;
  }

  /* Horizontal bar */
  .faq__icon::before {
    width: 14px;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  /* Vertical bar — fades out when open */
  .faq__icon::after {
    width: 1.5px;
    height: 14px;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  details[open] > .faq__question .faq__icon {
    transform: rotate(45deg);
  }

  details[open] > .faq__question .faq__icon::after {
    opacity: 0;
  }

  /* ── Answer (animated via grid trick — no JS) ── */

  .faq__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  details[open] > .faq__answer-wrap {
    grid-template-rows: 1fr;
  }

  .faq__answer-inner {
    overflow: hidden;
  }

  .faq__answer {
    margin: 0;
    padding-block-end: var(--space-md);
    max-width: 65ch;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__answer-wrap,
    .faq__icon,
    .faq__icon::after {
      transition: none;
    }
  }
</style>
