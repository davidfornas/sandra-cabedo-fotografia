---
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { getNavItems } from '../lib/nav';
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../images/logo.png';

// Full-logo options for the header. Switch by commenting/uncommenting one line.
import headerLogo from '../images/logos/logo-handwritten.png';
// import headerLogo from '../images/logos/logo-soft-typography.png';
// import headerLogo from '../images/logos/two-typographies-logo.png';
// import headerLogo from '../images/logos/two-typographies-logo-big.png';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const navItems = getNavItems();
const menuId = 'primary-navigation';
const sessionOptions = [
  { slug: 'embarazo', subtitle: 'Sola, en pareja o en familia' },
  { slug: 'crecer-juntos', subtitle: 'Contigo en diferentes momentos' },
  { slug: 'newborn', subtitle: 'Los primeros días o meses' },
  { slug: 'familia', subtitle: 'Una sesión con todos juntos' },
];
const entries = await getCollection('sessions');
const sessions = sessionOptions.map((option) => {
  const entry = entries.find((entry) => entry.slug === option.slug);
  if (!entry) throw new Error(`Sesión no encontrada: ${option.slug}`);
  return { ...option, ...entry.data, path: `/${option.slug}/` };
});
const sessionPaths = new Set(sessions.map((session) => session.path));
const sessionActive = sessionPaths.has(activePath);
const desktopNavItems = navItems.filter((item) => !sessionPaths.has(item.path));

function isActive(path: string): boolean {
  return path === activePath;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    {/* Option B — camera icon + text wordmark (kept for reference):
    <a class="site-header__logo" href={withBase('/')}>
      <Image class="site-header__logo-icon" src={logo} alt="" width={80} height={40} loading="eager" />
      <span class="site-header__logo-text">{site.brand.name}</span>
    </a>
    */}

    {/* Full logo (switch the file in the frontmatter import above). */}
    <a class="site-header__logo site-header__logo--full" href={withBase('/')}>
      <Image class="site-header__logo-full" src={headerLogo} alt={site.brand.name} width={216} height={72} loading="eager" />
    </a>

    <button
      class="site-header__toggle touch-target"
      type="button"
      data-nav-toggle
      aria-controls={menuId}
      aria-expanded="false"
    >
      <span class="site-header__toggle-label">Menú</span>
      <span class="site-header__toggle-icon" aria-hidden="true"></span>
    </button>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__menu" id={menuId} data-nav-menu>
        {
          navItems.map((item) => (
            <li>
              <a
                class="site-header__link touch-target"
                href={withBase(item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="site-header__desktop-menu">
        {desktopNavItems.map((item, index) => (
          <>
            <li>
              <a
                class="site-header__link touch-target"
                href={withBase(item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
            {index === 0 && (
              <li>
                <details class="sessions-menu" data-sessions-menu>
                  <summary
                    class:list={['site-header__link', 'touch-target', 'sessions-menu__trigger', { 'sessions-menu__trigger--active': sessionActive }]}
                    aria-controls="sessions-panel"
                  >
                    Sesiones
                    <svg class="sessions-menu__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="sessions-menu__panel" id="sessions-panel">
                    <ul class="sessions-menu__cards">
                      {sessions.map((session) => (
                        <li>
                          <a
                            class="sessions-menu__card"
                            href={withBase(session.path)}
                            aria-current={isActive(session.path) ? 'page' : undefined}
                          >
                            <Image
                              class="sessions-menu__photo"
                              src={session.coverImage}
                              alt={session.coverAlt}
                              width={88}
                              height={66}
                              widths={[88, 176]}
                              sizes="88px"
                              fit="cover"
                              loading="eager"
                            />
                            <span class="sessions-menu__text">
                              <span class="sessions-menu__title">{session.title}</span>
                              <span class="sessions-menu__subtitle">{session.subtitle}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            )}
          </>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav-toggle.ts';
  import '../scripts/sessions-menu.ts';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-block-end: 1px solid var(--color-surface-2);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    /* row-gap 0 keeps the header a single compact row when the nav is
       collapsed; column-gap separates logo from toggle horizontally */
    gap: 0 var(--space-sm);
    padding-block: 0.75rem;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-title);
    font-size: 1.375rem;
    line-height: 1.1;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__logo-icon {
    display: block;
    width: auto;
    height: 40px;
  }

  /* Full logo (3:1). Height drives size; width auto-scales to keep ratio. */
  .site-header__logo--full {
    gap: 0;
  }

  .site-header__logo-full {
    display: block;
    width: auto;
    height: 56px; /* compact on mobile; restored to 72px at the desktop breakpoint */
  }

  .site-header__logo:hover {
    color: var(--color-accent);
  }

  /* --- Toggle button: visible only on narrow viewports (Req 3.6) --- */
  .site-header__toggle {
    position: relative; /* contains the visually-hidden label */
    gap: var(--space-2xs);
    padding-inline: 0.875rem; /* tighter than the text+icon version */
    background: transparent;
    border: 1px solid var(--color-surface-2);
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    cursor: pointer;
  }

  /* Mobile: show only the hamburger icon. The label text stays in the
     accessibility tree so screen readers announce "Menú" on the button. */
  .site-header__toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header__toggle-icon {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    box-shadow:
      0 -6px 0 currentColor,
      0 6px 0 currentColor;
  }

  /* --- Navigation menu --- */
  .site-header__menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    display: flex;
    padding-inline: var(--space-xs);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--color-accent);
  }

  .site-header__link[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 500;
  }

  /*
    Mobile-first collapse (<= 768px): the menu is hidden by default and the
    toggle drives visibility via the [data-open] attribute set by
    nav-toggle.ts. Without JavaScript the toggle click does nothing, so the
    menu opens on wider viewports instead (see the min-width block below).
  */
  .site-header__nav {
    flex-basis: 100%;
  }

  .site-header__menu[data-nav-menu] {
    display: none;
    flex-direction: column;
    gap: var(--touch-gap);
    padding-block: var(--space-xs);
  }

  .site-header__menu[data-nav-menu][data-open='true'] {
    display: flex;
  }

  .site-header__desktop-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sessions-menu__trigger {
    gap: var(--space-2xs);
    cursor: pointer;
    list-style: none;
  }

  .sessions-menu__trigger::-webkit-details-marker { display: none; }
  .sessions-menu__trigger::marker { content: ''; }

  .sessions-menu__trigger--active,
  .sessions-menu[open] > summary {
    color: var(--color-accent);
  }

  .sessions-menu__chevron {
    flex: none;
    transition: transform 160ms ease;
  }

  .sessions-menu[open] .sessions-menu__chevron {
    transform: rotate(180deg);
  }

  .sessions-menu__panel {
    position: absolute;
    top: 100%;
    right: var(--space-lg);
    width: min(760px, calc(100% - 2 * var(--space-lg)));
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-2);
    box-shadow: 0 12px 24px rgb(43 38 34 / 8%);
    max-height: calc(100dvh - 12rem);
    overflow-y: auto;
  }

  .sessions-menu__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sessions-menu__card {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border-radius: 6px;
    color: var(--color-text);
    text-decoration: none;
  }

  .sessions-menu__card:hover,
  .sessions-menu__card:focus-visible,
  .sessions-menu__card[aria-current='page'] {
    background: var(--color-surface);
    color: var(--color-accent-strong);
  }

  .sessions-menu__photo {
    width: 88px;
    height: 66px;
    flex: none;
    object-fit: cover;
    border-radius: 6px;
  }

  .sessions-menu__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .sessions-menu__title {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .sessions-menu__chevron { transition: none; }
  }

  /* --- Tablet/desktop (>= 769px): grouped sessions, no mobile toggle --- */
  @media (min-width: 769px) {
    .site-header__inner {
      gap: var(--space-sm);
      padding-block: var(--space-sm);
    }

    .site-header__logo-full {
      height: 72px;
    }

    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      flex-basis: auto;
    }

    .site-header__menu[data-nav-menu],
    .site-header__menu[data-nav-menu][data-open='true'] {
      display: none;
    }

    .site-header__desktop-menu {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--touch-gap);
      padding-block: 0;
    }
  }
</style>
