---
import { Image, getImage } from 'astro:assets';
import type { GalleryImage } from '../lib/gallery';

interface Props {
  images: GalleryImage[];
  columns?: { base: number; md: number; lg: number };
}

const { images, columns = { base: 1, md: 2, lg: 3 } } = Astro.props;

const items = await Promise.all(
  images.map(async (image, index) => {
    const full = await getImage({ src: image.src, width: image.width, height: image.height });
    return {
      ...image,
      fullSrc: full.src,
      belowFold: index >= columns.lg,
    };
  })
);

const columnStyle = [
  `--gallery-columns-base: ${columns.base}`,
  `--gallery-columns-md: ${columns.md}`,
  `--gallery-columns-lg: ${columns.lg}`,
].join('; ');
---

<div class="gallery" style={columnStyle}>
  {
    items.map((item) => (
      <button
        type="button"
        class:list={['gallery__item', `gallery__item--${item.orientation}`]}
        data-lightbox={item.fullSrc}
        data-lightbox-alt={item.alt}
        aria-label={`Ampliar imagen: ${item.alt}`}
      >
        <Image
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading={item.belowFold ? 'lazy' : 'eager'}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 90vw"
          class="gallery__image"
        />
      </button>
    ))
  }
</div>

<div class="lightbox" data-lightbox-overlay hidden>
  <div
    class="lightbox__dialog"
    data-lightbox-dialog
    role="dialog"
    aria-modal="true"
    aria-label="Imagen ampliada"
    tabindex="-1"
  >
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Cerrar">
      <span aria-hidden="true">&times;</span>
    </button>
    <img class="lightbox__image" data-lightbox-image alt="" />
  </div>
</div>

<script>
  import '../scripts/lightbox.ts';
</script>

<style>
  .gallery {
    column-count: var(--gallery-columns-base, 1);
    column-gap: var(--space-sm);
    padding: 0;
    margin: 0;
  }

  .gallery__item {
    display: block;
    width: 100%;
    margin: 0 0 var(--space-sm);
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--color-surface);
    cursor: zoom-in;
    break-inside: avoid;
    appearance: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .gallery__image {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }

  .gallery__item:hover,
  .gallery__item:focus-visible {
    box-shadow: 0 12px 28px rgba(43, 38, 34, 0.14);
  }

  .gallery__item:hover .gallery__image,
  .gallery__item:focus-visible .gallery__image {
    transform: scale(1.04);
  }

  @media (min-width: 768px) {
    .gallery {
      column-count: var(--gallery-columns-md, 2);
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      column-count: var(--gallery-columns-lg, 3);
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    background-color: rgba(24, 20, 17, 0.9);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .lightbox[data-open='true'] {
    opacity: 1;
  }

  .lightbox[hidden] {
    display: none;
  }


  .lightbox__dialog {
    position: relative;
    max-width: min(100%, 1100px);
    max-height: 90vh;
    outline: none;
  }

  .lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .lightbox__close {
    position: absolute;
    top: calc(-1 * var(--space-lg));
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-bg);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item,
    .gallery__image,
    .lightbox {
      transition: none;
    }

    .gallery__item:hover .gallery__image,
    .gallery__item:focus-visible .gallery__image {
      transform: none;
    }
  }
</style>
