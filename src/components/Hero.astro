---
import type { ImageMetadata } from 'astro';
import ImageFrame from './ImageFrame.astro';
import SectionTitle from './SectionTitle.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  subtitle: string;
}

const { image, alt, title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <ImageFrame
      src={image}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="hero__image"
    />
  </div>

  <div class="hero__content container">
    <SectionTitle as="h1" align="start" class="hero__title">{title}</SectionTitle>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__cta">
      <WhatsAppCTA label="Reserva tu sesión" variant="primary" />
    </div>
  </div>
</section>

<!-- Below-image description — visible on mobile, hidden on desktop.
     display:none removes it from the a11y tree so the subtitle is never read twice. -->
<div class="hero__desc container">
  <p class="hero__desc-text">{subtitle}</p>
</div>

<style>
  /* ─────────────────────────────────────────────
     MOBILE — clean stacked layout
     Photograph is unobstructed.
     Heading and CTA flow below on the page background.
     ───────────────────────────────────────────── */

  .hero {
    position: relative;
    /* Plain block on mobile — no grid overlap */
  }

  /* Natural aspect-ratio crop; max-height prevents very tall phones
     from an excessively large image. */
  .hero__image {
    max-height: 75vh;
  }

  /* Flows directly below the image */
  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-md) var(--space-xs);
  }

  .hero__title {
    color: #5B4032;
  }

  .hero__title :global(.section-title__heading) {
    font-size: clamp(2.625rem, 10vw, 3rem);
    line-height: 1.07;
  }

  /* Subtitle inside overlay — hidden on mobile (shown in hero__desc instead) */
  .hero__subtitle {
    display: none;
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.5;
    color: #6A5549;
  }

  /* Below-image description (mobile only) */
  .hero__desc {
    padding-block: 0 var(--space-md);
  }

  .hero__desc-text {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .hero__cta {
    margin-block-start: var(--space-2xs);
  }

  .hero__cta :global(.whatsapp-cta) {
    min-height: 48px;
  }

  .hero__cta :global(.whatsapp-cta--primary) {
    background-color: #AD6439;
    border-color: #AD6439;
    color: #FFF9F4;
  }

  .hero__cta :global(.whatsapp-cta--primary:hover),
  .hero__cta :global(.whatsapp-cta--primary:focus-visible) {
    background-color: #93522D;
    border-color: #93522D;
  }

  /* ─────────────────────────────────────────────
     DESKTOP (≥ 769px) — grid overlay, unchanged
     ───────────────────────────────────────────── */

  @media (min-width: 769px) {
    .hero {
      display: grid;
    }

    .hero__media {
      grid-area: 1 / 1;
    }

    .hero__image {
      height: 70vh;
      min-height: 420px;
      max-height: 90vh;
    }

    .hero__content {
      grid-area: 1 / 1;
      z-index: 1;
      align-self: end;
      padding-block: 0;
      padding-block-end: var(--space-xl);
    }

    .hero__title :global(.section-title__heading) {
      font-size: clamp(2rem, 6vw, 3.25rem);
      line-height: 1.15;
    }

    .hero__subtitle {
      display: block;
      font-size: 1.1875rem;
    }

    .hero__desc {
      display: none;
    }
  }
</style>
