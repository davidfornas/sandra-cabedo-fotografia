---
import type { ImageMetadata } from 'astro';
import ImageFrame from './ImageFrame.astro';
import SectionTitle from './SectionTitle.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  subtitle: string;
}

const { image, alt, title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <ImageFrame
      src={image}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="hero__image"
    />
  </div>

  <div class="hero__content container">
    <SectionTitle as="h1" align="start" class="hero__title">{title}</SectionTitle>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__cta">
      <WhatsAppCTA label="Reserva tu sesión" variant="primary" />
    </div>
  </div>
</section>

<!-- Mobile only: subtitle below the photograph, on the page background.
     Hidden on desktop where the overlay version above is shown instead.
     display:none removes it from the a11y tree so content is not read twice. -->
<div class="hero__desc container">
  <p class="hero__desc-text">{subtitle}</p>
</div>

<style>
  /* ── Grid: image and content overlap ── */

  .hero {
    position: relative;
    display: grid;
  }

  .hero__media {
    grid-area: 1 / 1;
  }

  /* Mobile image: responsive height capped at 560px so the photograph
     fills the viewport without dominating very tall phones. */
  .hero__image {
    height: 75vh;
    min-height: 480px;
    max-height: 560px;
  }

  .hero__content {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block-end: var(--space-lg); /* tighter on mobile (2.5rem vs 4rem) */
  }

  /* ── Title ── */

  .hero__title {
    color: #5B4032;
  }

  /* Mobile: larger, tighter heading so the title reads as a clear focal
     point at phone widths without overwhelming the photograph. */
  .hero__title :global(.section-title__heading) {
    font-size: clamp(2.625rem, 10vw, 3rem);
    line-height: 1.07;
  }

  /* ── Subtitle (overlay version — desktop only) ── */

  .hero__subtitle {
    display: none; /* hidden on mobile; shown via the 769px block below */
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.5;
    color: #6A5549;
  }

  /* ── Below-image description (mobile only) ── */

  .hero__desc {
    background: var(--color-bg);
    padding-block: var(--space-sm) var(--space-md);
  }

  .hero__desc-text {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── CTA ── */

  .hero__cta {
    margin-block-start: var(--space-2xs);
  }

  /* Slightly taller touch target for the primary CTA on mobile */
  .hero__cta :global(.whatsapp-cta) {
    min-height: 48px;
  }

  .hero__cta :global(.whatsapp-cta--primary) {
    background-color: #AD6439;
    border-color: #AD6439;
    color: #FFF9F4;
  }

  .hero__cta :global(.whatsapp-cta--primary:hover),
  .hero__cta :global(.whatsapp-cta--primary:focus-visible) {
    background-color: #93522D;
    border-color: #93522D;
  }

  /* ── Desktop (≥ 769px) ── */

  @media (min-width: 769px) {
    /* Restore the original desktop image height range */
    .hero__image {
      height: 70vh;
      min-height: 420px;
      max-height: 90vh;
    }

    /* Restore desktop content padding */
    .hero__content {
      padding-block-end: var(--space-xl);
    }

    /* Restore base.css h1 sizing for desktop */
    .hero__title :global(.section-title__heading) {
      font-size: clamp(2rem, 6vw, 3.25rem);
      line-height: 1.15;
    }

    /* Show subtitle inside overlay on desktop */
    .hero__subtitle {
      display: block;
    }

    /* Hide below-image description on desktop */
    .hero__desc {
      display: none;
    }
  }
</style>
