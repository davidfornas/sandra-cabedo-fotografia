---
import type { ImageMetadata } from 'astro';
import ImageFrame from './ImageFrame.astro';
import SectionTitle from './SectionTitle.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  subtitle: string;
}

const { image, alt, title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <ImageFrame
      src={image}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="hero__image"
    />
  </div>

  <div class="hero__content container">
    <SectionTitle as="h1" align="start" class="hero__title">{title}</SectionTitle>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__cta">
      <WhatsAppCTA label="Reserva tu sesión" variant="primary" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
  }

  .hero__media {
    grid-area: 1 / 1;
  }

  .hero__image {
    height: 70vh;
    min-height: 420px;
    max-height: 90vh;
  }

  .hero__content {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block-end: var(--space-xl);
    color: var(--color-bg);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero__subtitle {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .hero__cta {
    margin-block-start: var(--space-2xs);
  }

  @media (min-width: 768px) {
    .hero__subtitle {
      font-size: 1.1875rem;
    }
  }
</style>
