---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes,
  class: className,
} = Astro.props;

const boxWidth = width ?? src.width;
const boxHeight = height ?? src.height;
const aspectRatio = `${boxWidth} / ${boxHeight}`;
---

<figure
  class:list={['image-frame', className]}
  style={`aspect-ratio: ${aspectRatio};`}
  data-image-frame
>
  <Image
    src={src}
    alt={alt}
    width={boxWidth}
    height={boxHeight}
    loading={loading}
    fetchpriority={fetchpriority}
    sizes={sizes}
    class="image-frame__img"
    onerror="this.closest('[data-image-frame]').setAttribute('data-image-failed', ''); this.removeAttribute('onerror');"
  />
  <span class="image-frame__fallback" role="img" aria-label="Imagen no disponible">
    <span class="image-frame__fallback-text">Imagen no disponible</span>
  </span>
</figure>

<style>
  .image-frame {
    position: relative;
    display: block;
    margin: 0;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .image-frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-frame__fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm);
    background-color: var(--color-surface-2);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .image-frame__fallback-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }

  .image-frame[data-image-failed] .image-frame__img {
    display: none;
  }

  .image-frame[data-image-failed] .image-frame__fallback {
    display: flex;
  }
</style>
