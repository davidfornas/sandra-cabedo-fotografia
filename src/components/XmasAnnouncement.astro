---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { withBase } from '../lib/url';
---

<!-- Christmas 2026 announcement strip — remove this component after the campaign -->
<div class="xmas-ann" role="region" aria-label="Campaña Navidad 2026">
  <div class="container xmas-ann__inner">

    <div class="xmas-ann__label">
      <span class="xmas-ann__season">Navidad 2026</span>
      <span class="xmas-ann__badge">Agenda abierta</span>
    </div>

    <p class="xmas-ann__desc">Sesiones de Navidad en Castellón</p>

    <a href={withBase('/navidad/')} class="xmas-ann__cta">
      <span class="xmas-ann__cta-mobile">Ver más</span>
      <span class="xmas-ann__cta-desktop">Descúbrelas</span>
      <ExternalLinkIcon />
    </a>

  </div>
</div>

<style>
  .xmas-ann {
    background-color: #AD6439;
    color: #FFF9F4;
  }

  /* Shared layout; mobile is condensed below. */
  .xmas-ann__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding-block: var(--space-md);
  }

  .xmas-ann__label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .xmas-ann__season {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
  }

  .xmas-ann__badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 8px;
    line-height: 1.4;
  }

  .xmas-ann__desc {
    margin: 0;
    max-width: none;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5;
    color: inherit;
  }

  .xmas-ann__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }

  .xmas-ann__cta:hover,
  .xmas-ann__cta:focus-visible {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xmas-ann__cta:focus-visible {
    outline-color: currentColor;
  }

  .xmas-ann__cta-desktop {
    display: none;
  }

  /* Mobile: keep only the campaign name and link in one compact row. */
  @media (max-width: 768px) {
    .xmas-ann__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block: var(--space-2xs);
    }

    .xmas-ann__badge,
    .xmas-ann__desc {
      display: none;
    }

    .xmas-ann__season,
    .xmas-ann__cta {
      white-space: nowrap;
    }
  }

  /* Desktop: single horizontal row */
  @media (min-width: 769px) {
    .xmas-ann__cta-mobile {
      display: none;
    }

    .xmas-ann__cta-desktop {
      display: inline;
    }

    .xmas-ann__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-lg);
      padding-block: var(--space-sm);
    }

    .xmas-ann__desc {
      flex: 1;
      text-align: center;
    }

    .xmas-ann__cta {
      min-height: unset; /* tight row, no oversized touch area needed on desktop */
    }
  }
</style>
