---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import SectionTitle from './SectionTitle.astro';
import Gallery from './Gallery.astro';
import WhatsAppCTA, { type WhatsAppLabel } from './WhatsAppCTA.astro';
import SessionFAQ, { type FaqItem } from './SessionFAQ.astro';
import type { GalleryImage } from '../lib/gallery';

interface Props {
  slug: 'newborn' | 'familia' | 'crecer-juntos' | 'embarazo';
  path: string;
  seoTitle: string;
  seoDescription: string;
  ctaLabel: WhatsAppLabel;
  conceptLine?: string;
  faqItems?: FaqItem[];
  faqSubtitle?: string;
}

const { slug, path, seoTitle, seoDescription, ctaLabel, conceptLine, faqItems, faqSubtitle } = Astro.props;

const entry = await getEntry('sessions', slug);
if (!entry) {
  throw new Error(`No se encontró la entrada de sesión "${slug}".`);
}

const { title, description, images } = entry.data;

const galleryImages: GalleryImage[] = images.map((image) => ({
  src: image.src,
  alt: image.alt,
  width: image.src.width,
  height: image.src.height,
  orientation: image.orientation,
}));

const { Content } = await render(entry);
---

<PageLayout
  title={seoTitle}
  description={seoDescription}
  path={path}
  activePath={path}
  showFooterSocial={true}
>
  <article class="session section">

    <!-- Intro: heading, description, top CTA -->
    <div class="container session__intro">
      <SectionTitle as="h1" eyebrow="Sesión">{title}</SectionTitle>
      <p class="session__description">{description}</p>
      {conceptLine && <p class="session__concept">{conceptLine}</p>}
      <div class="cluster session__cta">
        <WhatsAppCTA label={ctaLabel} />
      </div>
    </div>

    <!-- Gallery -->
    <div class="container session__gallery">
      <Gallery images={galleryImages} />
    </div>

    <!-- Editorial notice from markdown body -->
    <div class="container">
      <div class="session__body">
        <Content />
      </div>
    </div>

    <!-- FAQ -->
    {/* FAQ disabled — texts under review:
    {faqItems && faqItems.length > 0 && (
      <SessionFAQ items={faqItems} subtitle={faqSubtitle} />
    )}
    */}

    <!-- Bottom CTA -->
    <div class="container session__footer-cta">
      <p class="session__footer-cta-text">¿Te quedó alguna duda o ya sabes que quieres reservar?</p>
      <WhatsAppCTA label={ctaLabel} />
    </div>

  </article>
</PageLayout>

<style>
  .session__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .session__description {
    max-width: 60ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .session__concept {
    max-width: 60ch;
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.375rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .session__gallery {
    margin-block-end: var(--space-xl);
  }

  /* ── Editorial notice (markdown body from content file) ── */

  .session__body {
    padding-block: var(--space-lg);
    border-block: 1px solid var(--color-surface-2);
    max-width: 65ch;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .session__body :global(p) {
    margin-block: 0 var(--space-sm);
  }

  .session__body :global(p:last-child) {
    margin-block-end: 0;
  }

  .session__body :global(h2) {
    font-family: var(--font-title);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 var(--space-md);
  }

  .session__body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ── Bottom CTA ── */

  .session__footer-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-xl);
    border-block-start: 1px solid var(--color-surface-2);
  }

  .session__footer-cta-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 50ch;
  }

  @media (min-width: 769px) {
    .session__footer-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-lg);
    }

    .session__footer-cta-text {
      font-size: 1.0625rem;
    }
  }
</style>
